p::before{display:none}\n.step{position:relative;padding:0 0 14px 18px;font-size:16px;line-height:1.55}\n\n.step:last-child{padding-bottom:0}\n.step p{margin:0 0 10px;min-height:3.1em;text-wrap:pretty}\n.chips{display:flex;flex-direction:column;align-items:flex-start;gap:8px}\n.chips .ref{margin-top:0}\n.seq .open>.vb>.vi{padding-bottom:12px}\n.seq .k{flex:none;width:26px;height:26px;border-radius:50%;background:var(--chip);color:var(--chipTx);display:grid;place-items:center;font:700 12px 'Barlow',sans-serif}\n.chips{align-items:stretch!important;width:100%}\n.chain .ref{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;margin:0;padding:0;border-radius:0;background:none;color:var(--tx);font:inherit}\n.chain .ref:active{background:none;opacity:.6}\n.chain .ic{display:none}\n.chain .tx{display:flex;flex-direction:column;flex:1;min-width:0;line-height:1.25}\n.chain .full,.chain .bk{font:600 15px 'DM Sans',sans-serif}\n.chain .ref svg.go{flex:none;width:16px;height:16px;stroke:var(--tx2);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.chips{gap:8px}\n.chain .ref{min-height:60px;padding:0 16px 0 12px;background:var(--in);border:1px solid var(--bd);border-radius:18px}\n.chain .ic{display:grid;place-items:center;flex:none;width:38px;height:38px;border-radius:50%;background:var(--chip)}\n.chain .ic svg{width:19px;height:19px;stroke:var(--chipTx);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.vcard{background:var(--in)}\n.vcard p.v{display:block;margin:0 0 14px;font-style:normal;font-size:16px;line-height:1.6}\n.vcard p.v:last-of-type{margin-bottom:0}\n.vcard .vn{display:inline-grid;place-items:center;width:24px;height:24px;margin:0 8px 0 0;border-radius:50%;background:var(--chip);color:var(--chipTx);font:700 11px/1 'Barlow',sans-serif;vertical-align:.3em}\n.vend{margin:16px 0 0;padding:0}\n.cit{position:relative;margin:28px 0 32px;padding:18px 20px 16px 22px;background:var(--in);border:1px solid var(--bd);border-radius:24px;overflow:hidden}\n.vi .cit{margin:8px 0 0}\n.vi .cit+.cit{margin-top:8px}\n.step .cit{margin:2px 0 0}\n.cit+.cit{margin-top:-8px}\n.cit:last-child{margin-bottom:6px}\n.cit::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:30px;box-sizing:border-box;border-left:3px solid var(--main);border-radius:23px 0 0 23px;pointer-events:none}\n.cit blockquote{margin:0;padding:0;font:400 calc(var(--fs) - 1px)/1.65 'DM Sans',sans-serif;color:#444}\n.cit figcaption{display:block;margin:12px 0 0;padding:0;text-align:right;font:500 13.5px/1.5 'DM Sans',sans-serif;color:var(--tx2)}\n.cit figcaption::before{content:\"\\2014\\00a0\"}\n.seq .k{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\n.sqh{touch-action:manipulation;-webkit-tap-highlight-color:transparent}\n.refpop{position:absolute;z-index:60;max-width:calc(100vw - 24px);padding:9px 14px;border-radius:14px;background:#2b2723;color:#fff;font:600 13.5px/1.55 'DM Sans',sans-serif;box-shadow:0 6px 22px rgba(0,0,0,.25);opacity:0;pointer-events:none}\n.refpop.on{opacity:1;transform:none}\n.cit blockquote p{margin:0 0 10px;font:inherit}\n.cit blockquote p:last-child{margin-bottom:0}\n.cit.bv{cursor:pointer}\n.cit.bv figcaption{display:none;text-align:left;font:700 13px/1.4 'DM Sans',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--main)}\n.cit.bv.on figcaption{display:block}\n.cit.bv figcaption::before{content:none}\n.cit.bv figcaption a.in{color:inherit;text-decoration-color:var(--main)}\n/* Citação ou relato longo: linha do tempo, um ponto por parágrafo (nunca em texto bíblico) */\n.cit.tl{padding:22px 20px 16px 18px}\n.cit.tl::before{display:none}\n.cit.tl blockquote{position:relative;padding-left:26px}\n.cit.tl blockquote::before{content:\"\";position:absolute;left:5px;top:14px;bottom:14px;width:2px;border-radius:2px;background:var(--bd)}\n.cit.tl blockquote p.gen{position:relative;margin:0 0 20px}\n.cit.tl blockquote p.gen:last-child{margin-bottom:0}\n.cit.tl blockquote p.gen::before{content:\"\";position:absolute;left:-26px;top:.55em;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:var(--in);border:2.5px solid var(--main)}\n.cit.tl figcaption{margin-top:18px;padding-top:14px;border-top:1px solid var(--bd)}\n/* Respiro maior entre lista de passos e o texto em volta */\n.card>ul.seq{margin:24px 0 32px}\n.card>ul.seq+p{margin-top:0!important}\n.card>p+ul.seq{margin-top:26px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <section class=\"card\"><div class=\"sec-h\"><h2>Jesus e o Espírito</h2></div>\n<p>A verdade sobre a necessidade do batismo do Espírito Santo para o testemunho é claramente revelada no Novo Testamento. Vemos isso na experiência de Jesus.</p>\n<p class=\"pm\">Lucas descreve o batismo de Cristo com água no capítulo três do seu evangelho. Ele conta que, no batismo, Jesus orou e o Espírito Santo desceu sobre Ele em forma corporal, como pomba, e uma voz do céu disse: Tu és o meu Filho amado, em ti me comprazo (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/LUK.3.21-22.NVI\" target=\"_blank\" rel=\"noopener\">Lucas 3:21-22</a>).</p>\n<p class=\"pm\">A partir daquele momento, Lucas diz que Jesus foi \"cheio\" do Espírito Santo e ministrou no \"poder\" do Espírito. Cheio do Espírito, voltou do Jordão e foi conduzido pelo Espírito ao deserto (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/LUK.4.1.NVI\" target=\"_blank\" rel=\"noopener\">Lucas 4:1</a>).</p>\n<p class=\"pm\">Jesus voltou para a Galileia no poder do Espírito, e a Sua fama se espalhou por toda a região (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/LUK.4.14.NVI\" target=\"_blank\" rel=\"noopener\">Lucas 4:14</a>).</p>\n<p>Antes dessa plenitude do Espírito, ou batismo, não há registro de ministério de Cristo, e não se diz que seguidores se aproximassem dEle. Logo depois de ser batizado, ou cheio do Espírito, lemos que a Sua fama se espalhou por toda a região.</p>\n<p>Depois de Cristo ser cheio do Espírito Santo, lemos em todos os evangelhos sobre milhares que responderam à Sua mensagem e ao Seu ministério. Todos os ensinos de Cristo foram ungidos pelo poder do Espírito Santo, resultado de ter sido cheio do Espírito em resposta à Sua oração na hora do batismo com água.</p>\n<p class=\"pm\">Jesus disse que o Espírito do Senhor estava sobre Ele, porque o ungira para pregar o evangelho aos pobres, curar os quebrantados de coração, proclamar libertação aos cativos e vista aos cegos, pôr em liberdade os oprimidos e proclamar o ano aceitável do Senhor (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/LUK.4.18-19.NVI\" target=\"_blank\" rel=\"noopener\">Lucas 4:18-19</a>).</p>\n<p class=\"pm\">Depois da ressurreição, Jesus deu mandamentos aos apóstolos pelo Espírito Santo (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.1.2.NVI\" target=\"_blank\" rel=\"noopener\">Atos 1:2</a>). E Deus ungiu Jesus de Nazaré com o Espírito Santo e com poder: Ele andou por toda parte fazendo o bem e curando todos os oprimidos do diabo, porque Deus estava com Ele (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.10.38.NVI\" target=\"_blank\" rel=\"noopener\">Atos 10:38</a>).</p>\n<div class=\"sec-h mid\"><h2>Esperar a promessa</h2></div>\n<p>Jesus conhecia bem a importância e a necessidade do ministério cheio do Espírito. Por isso disse aos discípulos que esperassem a promessa do batismo do Espírito Santo antes de saírem a proclamar o evangelho.</p>\n<p class=\"pm\">Reunido com eles, ordenou que não saíssem de Jerusalém, mas esperassem a promessa do Pai: João batizou com água, mas eles seriam batizados com o Espírito Santo dentro de poucos dias (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.1.4-5.NVI\" target=\"_blank\" rel=\"noopener\">Atos 1:4-5</a>).</p>\n<p class=\"pm\">Jesus disse ainda que eles receberiam poder para testemunhar quando recebessem o batismo do Espírito Santo, e seriam testemunhas em Jerusalém, em toda a Judeia, em Samaria e até os confins da terra (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.1.8.NVI\" target=\"_blank\" rel=\"noopener\">Atos 1:8</a>).</p>\n<p class=\"pm\">Os discípulos fizeram o que Jesus pediu. Esperaram e oraram unidos pelo cumprimento da promessa do batismo do Espírito Santo: todos perseveravam unânimes em oração e súplicas, com as mulheres, Maria, mãe de Jesus, e os irmãos dele (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.1.14.NVI\" target=\"_blank\" rel=\"noopener\">Atos 1:14</a>).</p>\n<div class=\"sec-h mid\"><h2>Pentecostes</h2></div>\n<p>Em resposta aos seus dez dias de oração, o Espírito Santo veio no dia de Pentecostes, e todos ficaram cheios do Espírito Santo.</p>\n<p>Quando chegou o dia de Pentecostes, estavam todos reunidos num só lugar. De repente veio do céu um som como de um vento impetuoso e encheu toda a casa onde estavam sentados.</p>\n<p class=\"pm\">Línguas como de fogo, repartidas, pousaram sobre cada um deles, e todos ficaram cheios do Espírito Santo e começaram a falar em outras línguas, conforme o Espírito lhes concedia (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.2.1-4.NVI\" target=\"_blank\" rel=\"noopener\">Atos 2:1-4</a>).</p>\n<p>O que aconteceu em seguida revela um dos principais propósitos do batismo do Espírito Santo. Deus usou esses crentes cheios do Espírito para falar das \"grandes obras de Deus\".</p>\n<p>Todos ficaram pasmados e maravilhados, perguntando se aqueles que falavam não eram todos galileus e como cada um os ouvia falar na sua própria língua materna.</p>\n<p class=\"pm\">Havia partos, medos, elamitas, habitantes da Mesopotâmia, da Judeia e da Capadócia, do Ponto e da Ásia, da Frígia e da Panfília, do Egito e da Líbia perto de Cirene, romanos, judeus, prosélitos, cretenses e árabes, todos ouvindo as grandes obras de Deus (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.2.7-11.NVI\" target=\"_blank\" rel=\"noopener\">Atos 2:7-11</a>).</p>\n<p class=\"pm\">Deus superou até as barreiras de idioma para levar a boa notícia de um Salvador ressuscitado aos judeus presentes naquele dia. Três mil responderam ao sermão cheio do Espírito de Pedro: os que receberam com alegria a sua palavra foram batizados (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.2.41.NVI\" target=\"_blank\" rel=\"noopener\">Atos 2:41</a>).</p>\n<p class=\"pm\">A igreja primitiva continuou a ministrar sob o poder de unção do Espírito Santo. Deus trabalhou de modo maravilhoso por meio desses crentes para ganhar muitos outros para Cristo: eles louvavam a Deus e tinham a simpatia de todo o povo, e o Senhor lhes acrescentava diariamente os que iam sendo salvos (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.2.47.NVI\" target=\"_blank\" rel=\"noopener\">Atos 2:47</a>).</p>\n<p>Esses primeiros cristãos reconheciam a urgência de receber o batismo do Espírito Santo para viver uma vida piedosa e testemunhar com eficácia por seu Senhor.</p>\n<div class=\"sec-h mid\"><h2>Samaria e Saulo</h2></div>\n<p>O batismo do Espírito foi tão importante que, quando muitos samaritanos, homens e mulheres, aceitaram Jesus como Salvador e foram batizados em água no ministério de Filipe, Pedro e João foram enviados ao encontro deles.</p>\n<p class=\"pm\">Pouco depois de chegarem, impuseram as mãos sobre esses crentes recém-batizados e oraram para que recebessem o batismo do Espírito Santo (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.8.12-17.NVI\" target=\"_blank\" rel=\"noopener\">Atos 8:12-17</a>).</p>\n<p>Eles tinham sido batizados em água em nome do Senhor Jesus, mas o Espírito ainda não havia descido sobre nenhum deles. Só depois que Pedro e João lhes impuseram as mãos, eles receberam o Espírito Santo.</p>\n<p>Vemos a mesma prioridade no chamado de Deus a Saulo no caminho de Damasco. Cristo se revelou a Saulo em uma visão: ele respirava ameaças e morte contra os discípulos do Senhor e pediu ao sumo sacerdote cartas para as sinagogas de Damasco, a fim de levar presos a Jerusalém os que seguissem o Caminho, fossem homens ou mulheres.</p>\n<p>Perto de Damasco, uma luz do céu brilhou ao redor dele, e ele caiu por terra e ouviu uma voz: Saulo, Saulo, por que você me persegue? Ele perguntou quem era, e o Senhor respondeu: Eu sou Jesus, a quem você persegue.</p>\n<p class=\"pm\">Tremendo e atônito, Saulo perguntou o que o Senhor queria que fizesse, e o Senhor mandou que se levantasse e entrasse na cidade, onde lhe seria dito o que fazer. Os homens que viajavam com ele ficaram sem fala, ouvindo a voz mas sem ver ninguém (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.9.1-7.NVI\" target=\"_blank\" rel=\"noopener\">Atos 9:1-7</a>).</p>\n<p>Então Cristo orientou Saulo a ir a Damasco e esperar mais instruções, e depois Deus enviou Ananias para impor as mãos sobre ele e orar pelo batismo do Espírito Santo e pela cura da sua visão.</p>\n<p class=\"pm\">Ananias entrou na casa, impôs as mãos sobre ele e disse: Irmão Saulo, o Senhor Jesus, que lhe apareceu no caminho, me enviou para que você recobre a vista e fique cheio do Espírito Santo. Imediatamente algo como escamas caiu dos seus olhos, e ele recuperou a vista, levantou-se e foi batizado (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.9.17-18.NVI\" target=\"_blank\" rel=\"noopener\">Atos 9:17-18</a>).</p>\n<p class=\"pm\">Como resultado da plenitude do Espírito, Saulo se fortalecia cada vez mais (<a class=\"in\" href=\"https://www.bible.com/pt/bible/129/ACT.9.22.NVI\" target=\"_blank\" rel=\"noopener\">Atos 9:22</a>). A palavra força não se refere apenas à força física. O contexto indica que Saulo cresceu em força espiritual e em poder para proclamar o evangelho.</p>\n<p>Esse poder espiritual para testemunhar resultou do batismo do Espírito Santo que ele recebeu quando Ananias orou por ele.</p>\n<div class=\"sec-h mid\"><h2>Reflexão pessoal</h2></div>\n<p>Reserve um tempo para refletir e conversar com alguém sobre estas quatro perguntas:</p>\n<ul class=\"seq\">\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">1</span><span class=\"sqt\">Serviço poderoso</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Quando o serviço de Jesus ao Pai se tornou poderoso, e como a Bíblia descreve o Seu ministério batizado pelo Espírito?</p></div></div>\n</div></div>\n</li>\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">2</span><span class=\"sqt\">Antes de ministrar</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>O que Jesus disse aos discípulos que fizessem antes de começarem a ministrar?</p></div></div>\n</div></div>\n</li>\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">3</span><span class=\"sqt\">Resultados da igreja</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Que resultados a igreja primitiva teve depois de receber o batismo do Espírito Santo?</p></div></div>\n</div></div>\n</li>\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">4</span><span class=\"sqt\">Pedro, João e Ananias</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Por que Deus enviou Pedro e João aos novos crentes samaritanos, e Ananias a Saulo depois da sua conversão?</p></div></div>\n</div></div>\n</li>\n</ul>\n<p>Essas perguntas mostram que, do começo ao fim da Bíblia, o testemunho eficaz nasce do batismo do Espírito Santo.</p>\n<div class=\"sec-h mid\"><h2>Atividade de oração</h2></div>\n<p>Ligue para o seu parceiro de oração e converse com ele ou ela sobre este devocional. Depois, orem juntos pedindo estas três coisas:</p>\n<ul class=\"seq\">\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">1</span><span class=\"sqt\">Batismo contínuo</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Peça que Deus continue a batizar cada um de vocês com o Seu Santo Espírito.</p></div></div>\n</div></div>\n</li>\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">2</span><span class=\"sqt\">Testemunho no poder</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Peça que Deus dê testemunho por meio de você no poder do Espírito Santo.</p></div></div>\n</div></div>\n</li>\n<li class=\"tg\">\n<button type=\"button\" class=\"sqh\" aria-expanded=\"false\"><span class=\"k\">3</span><span class=\"sqt\">Lista de oração</span></button>\n<div class=\"vb\"><div class=\"vi\">\n<div class=\"chain\"><div class=\"step\"><p>Ore pelas pessoas que estão na sua lista de oração, uma por uma, diante de Deus.</p></div></div>\n</div></div>\n</li>\n</ul>\n<p class=\"pm\">Inclua em sua oração o pedido de <a class=\"in\" href=\"https://www.bible.com/pt/bible/129/PSA.119.25.NVI\" target=\"_blank\" rel=\"noopener\">Salmos 119:25</a>: o salmista, prostrado no pó, pede que Deus preserve a sua vida conforme a Sua palavra.</p>\n<p>Termine com esta oração: Senhor, estamos longe de onde deveríamos estar espiritualmente. Restaura-nos espiritualmente, como Tu prometeste. Dá-nos o batismo do Teu Espírito, para que sejamos testemunhas eficazes de Jesus, como foram os discípulos, Saulo e todos os crentes da igreja primitiva.</p>\n</section>\n\n</div>\n\n\n\n<script>\n(function(){\nvar SEL='.card p:not(.pm):not(.gen),.step p';\nfunction texts(el){var w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),n=[],t;while(t=w.nextNode())n.push(t);return n}\nfunction lastLineWords(el){var n=texts(el),top=null,words=0,r=document.createRange(),seenSpace=false,chars=0;\n for(var k=n.length-1;k>=0;k--){var v=n[k].nodeValue;for(var j=v.length-1;j>=0;j--){r.setStart(n[k],j);r.setEnd(n[k],j+1);var rc=r.getClientRects();if(!rc.length)continue;var t=Math.round(rc[0].top);if(top===null)top=t;if(Math.abs(t-top)>4)return {w:words+(chars?1:0),c:chars};var ch=v.charAt(j);if(ch===' '||ch==='\\u00a0'){if(chars){words++;chars=0}}else chars++;}}\n return {w:words+(chars?1:0),c:chars};}\nfunction lineWidths(el){var r=document.createRange();r.selectNodeContents(el);var rs=[].slice.call(r.getClientRects()).filter(function(x){return x.width>1}),m={};rs.forEach(function(x){var k=Math.round(x.top/6);m[k]=m[k]||[1e9,0];m[k][0]=Math.min(m[k][0],x.left);m[k][1]=Math.max(m[k][1],x.right)});return Object.keys(m).sort(function(a,b){return a-b}).map(function(k){return m[k][1]-m[k][0]})}\nfunction tie(el){var n=texts(el),c=0;for(var k=n.length-1;k>=0&&c<2;k--){var v=n[k].nodeValue,o='',j;for(j=v.length-1;j>=0;j--){var ch=v.charAt(j);if(ch===' '&&c<2&&j>0&&j<v.length-1){ch='\\u00a0';c++}o=ch+o}n[k].nodeValue=o}}\nfunction untie(el){var n=texts(el);for(var k=0;k<n.length;k++)n[k].nodeValue=n[k].nodeValue.replace(/\\u00a0/g,' ')}\nfunction hy(el){var t=texts(el);for(var q=0;q<t.length;q++)if(!/-⁠/.test(t[q].nodeValue))t[q].nodeValue=t[q].nodeValue.replace(/(\\S)-(?=\\S)/g,'$1-⁠')}\nfunction run(){var L=document.querySelectorAll(SEL);for(var i=0;i<L.length;i++){var el=L[i];if(!el.offsetParent)continue;untie(el);hy(el);el.style.maxWidth='';var full=el.getBoundingClientRect().width,best=null,pcts=[100,98,96,94];for(var pi=0;pi<pcts.length;pi++){el.style.maxWidth=pcts[pi]+'%';var ws=lineWidths(el),w=full*pcts[pi]/100,lw2=lastLineWords(el);var ok=ws.length<2||(lw2.w>=3&&ws[ws.length-1]>=w*0.3&&ws[ws.length-2]>=w*0.8);if(ok){best=pcts[pi];break}}el.style.maxWidth=(best===null||best===100)?'':best+'%';}\n var Q=document.querySelectorAll('.cit blockquote');for(var m=0;m<Q.length;m++)hy(Q[m])}\nwindow.__fixText=run;\nif(document.fonts&&document.fonts.ready)document.fonts.ready.then(run);else run();\nwindow.addEventListener('load',run);window.addEventListener('resize',run);\ndocument.addEventListener('click',function(){setTimeout(run,320)});\n})();\n(function(){\n    function sync(box,open){\n    var h=box.querySelector(':scope > button'); if(h) h.setAttribute('aria-expanded',open?'true':'false');\n    if(box.id){\n      var r=document.querySelectorAll('.vref[data-alvo=\"'+box.id+'\"]');\n      for(var k=0;k<r.length;k++) r[k].setAttribute('aria-expanded',open?'true':'false');\n    }\n    if(open){\n      setTimeout(function(){\n        var rc=box.getBoundingClientRect(), over=rc.bottom-(window.innerHeight-16);\n        if(over>0){\n          var room=rc.top-130;\n          window.scrollBy({top:Math.max(0,Math.min(over,room)),behavior:'smooth'});\n        }\n      },320);\n    }\n  }\n  window.__sync=sync;\n  var heads=document.querySelectorAll('.tg > button');\n  for(var j=0;j<heads.length;j++){\n    heads[j].addEventListener('click',function(){\n      var box=this.parentNode; sync(box,box.classList.toggle('open'));\n    });\n  }\n})();\n\n(function(){\nvar N={GEN:'Gênesis',EXO:'Êxodo',LEV:'Levítico',NUM:'Números',DEU:'Deuteronômio',JOS:'Josué',JDG:'Juízes',RUT:'Rute','1SA':'1 Samuel','2SA':'2 Samuel','1KI':'1 Reis','2KI':'2 Reis','1CH':'1 Crônicas','2CH':'2 Crônicas',EZR:'Esdras',NEH:'Neemias',EST:'Ester',JOB:'Jó',PSA:'Salmos',PRO:'Provérbios',ECC:'Eclesiastes',SNG:'Cantares',ISA:'Isaías',JER:'Jeremias',LAM:'Lamentações',EZK:'Ezequiel',DAN:'Daniel',HOS:'Oseias',JOL:'Joel',AMO:'Amós',OBA:'Obadias',JON:'Jonas',MIC:'Miqueias',NAM:'Naum',HAB:'Habacuque',ZEP:'Sofonias',HAG:'Ageu',ZEC:'Zacarias',MAL:'Malaquias',MAT:'Mateus',MRK:'Marcos',LUK:'Lucas',JHN:'João',ACT:'Atos',ROM:'Romanos','1CO':'1 Coríntios','2CO':'2 Coríntios',GAL:'Gálatas',EPH:'Efésios',PHP:'Filipenses',COL:'Colossenses','1TH':'1 Tessalonicenses','2TH':'2 Tessalonicenses','1TI':'1 Timóteo','2TI':'2 Timóteo',TIT:'Tito',PHM:'Filemom',HEB:'Hebreus',JAS:'Tiago','1PE':'1 Pedro','2PE':'2 Pedro','1JN':'1 João','2JN':'2 João','3JN':'3 João',JUD:'Judas',REV:'Apocalipse'};\nfunction ref(a){var m=/bible\\/129\\/([0-9A-Z]+)\\.(\\d+)(?:\\.([\\d\\-]+))?\\.NVI/.exec(a.getAttribute('href')||'');if(!m)return '';return (N[m[1]]||m[1])+' '+m[2]+(m[3]?':'+m[3]:'')}\nvar pop=null,tm=null,hide=null,held=false,sx=0,sy=0;\nfunction fecha(){if(pop){pop.classList.remove('on');var p=pop;setTimeout(function(){if(p.parentNode)p.parentNode.removeChild(p)},220);pop=null}clearTimeout(hide)}\nfunction mostra(k){var li=k.closest('li');if(!li)return;var seen={},out=[],as=li.querySelectorAll('a.in');\n for(var i=0;i<as.length;i++){var r=ref(as[i]);if(r&&!seen[r]){seen[r]=1;out.push(r)}}\n if(!out.length)return;fecha();pop=document.createElement('div');pop.className='refpop';pop.textContent=out.join('\\n');pop.style.whiteSpace='pre-line';document.body.appendChild(pop);\n var rc=k.getBoundingClientRect(),w=pop.offsetWidth,left=Math.max(12,Math.min(rc.left+window.pageXOffset,window.pageXOffset+document.documentElement.clientWidth-w-12));\n pop.style.left=left+'px';pop.style.top=(rc.bottom+window.pageYOffset+8)+'px';\n requestAnimationFrame(function(){if(pop)pop.classList.add('on')});\n hide=setTimeout(fecha,3500);held=true}\ndocument.addEventListener('pointerdown',function(e){var k=e.target.closest&&e.target.closest('.seq .k');if(!k)return;sx=e.clientX;sy=e.clientY;held=false;clearTimeout(tm);tm=setTimeout(function(){mostra(k)},420)});\n['pointerup','pointercancel'].forEach(function(t){document.addEventListener(t,function(){clearTimeout(tm)})});\ndocument.addEventListener('pointermove',function(e){if(Math.abs(e.clientX-sx)>12||Math.abs(e.clientY-sy)>12)clearTimeout(tm)});\ndocument.addEventListener('contextmenu',function(e){if(e.target.closest&&e.target.closest('.seq .k'))e.preventDefault()});\ndocument.addEventListener('click',function(e){if(held){held=false;e.stopPropagation();e.preventDefault()}},true);\n})();\n(function(){\nvar V=document.querySelectorAll('.cit.bv');\nfor(var i=0;i<V.length;i++){(function(v){\n v.setAttribute('role','button');v.setAttribute('tabindex','0');\n function t(e){if(e.target.closest&&e.target.closest('a'))return;v.classList.toggle('on')}\n v.addEventListener('click',t);\n v.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();t(e)}});\n})(V[i])}\n})();\n(function(){\nvar B=document.querySelectorAll('.cit.bv > blockquote');\nfor(var i=0;i<B.length;i++){var b=B[i];if(b.children.length||b.textContent.length<400)continue;var s=b.textContent.replace(/([.!?\\u2026]\\)?)\\s+(?=[A-Z\\u00C0-\\u00DD\\u201C\"])/g,'$1\\u0001').split('\\u0001');if(s.length<2)continue;b.textContent='';for(var k=0;k<s.length;k++){var e=document.createElement('p');e.className='gen';e.textContent=s[k];b.appendChild(e)}}\nvar F=document.querySelectorAll('.cit');\nfor(var i=0;i<F.length;i++){var P=F[i].querySelectorAll('blockquote > p.gen');if(P.length<2)continue;var n=0;for(var j=0;j<P.length;j++)n+=P[j].textContent.length;if(P.length>=3||n>(F[i].classList.contains('bv')?400:700))F[i].classList.add('tl');else{for(var k=1;k<P.length;k++){P[0].appendChild(document.createTextNode(' '));while(P[k].firstChild)P[0].appendChild(P[k].firstChild);P[k].parentNode.removeChild(P[k])}}}\n})();\n</script>\n</body>\n</html>\n"}