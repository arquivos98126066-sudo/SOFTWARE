lectorAll('.cit blockquote');for(var m=0;m<Q.length;m++)hy(Q[m])}\nwindow.__fixText=run;\nif(document.fonts&&document.fonts.ready)document.fonts.ready.then(run);else run();\nwindow.addEventListener('load',run);window.addEventListener('resize',run);\ndocument.addEventListener('click',function(){setTimeout(run,320)});\n})();\n(function(){\n    function sync(box,open){\n    var h=box.querySelector(':scope > button'); if(h) h.setAttribute('aria-expanded',open?'true':'false');\n    if(box.id){\n      var r=document.querySelectorAll('.vref[data-alvo=\"'+box.id+'\"]');\n      for(var k=0;k<r.length;k++) r[k].setAttribute('aria-expanded',open?'true':'false');\n    }\n    if(open){\n      setTimeout(function(){\n        var rc=box.getBoundingClientRect(), over=rc.bottom-(window.innerHeight-16);\n        if(over>0){\n          var room=rc.top-130;\n          window.scrollBy({top:Math.max(0,Math.min(over,room)),behavior:'smooth'});\n        }\n      },320);\n    }\n  }\n  window.__sync=sync;\n  var heads=document.querySelectorAll('.tg > button');\n  for(var j=0;j<heads.length;j++){\n    heads[j].addEventListener('click',function(){\n      var box=this.parentNode; sync(box,box.classList.toggle('open'));\n    });\n  }\n})();\n\n(function(){\nvar N={GEN:'Gênesis',EXO:'Êxodo',LEV:'Levítico',NUM:'Números',DEU:'Deuteronômio',JOS:'Josué',JDG:'Juízes',RUT:'Rute','1SA':'1 Samuel','2SA':'2 Samuel','1KI':'1 Reis','2KI':'2 Reis','1CH':'1 Crônicas','2CH':'2 Crônicas',EZR:'Esdras',NEH:'Neemias',EST:'Ester',JOB:'Jó',PSA:'Salmos',PRO:'Provérbios',ECC:'Eclesiastes',SNG:'Cantares',ISA:'Isaías',JER:'Jeremias',LAM:'Lamentações',EZK:'Ezequiel',DAN:'Daniel',HOS:'Oseias',JOL:'Joel',AMO:'Amós',OBA:'Obadias',JON:'Jonas',MIC:'Miqueias',NAM:'Naum',HAB:'Habacuque',ZEP:'Sofonias',HAG:'Ageu',ZEC:'Zacarias',MAL:'Malaquias',MAT:'Mateus',MRK:'Marcos',LUK:'Lucas',JHN:'João',ACT:'Atos',ROM:'Romanos','1CO':'1 Coríntios','2CO':'2 Coríntios',GAL:'Gálatas',EPH:'Efésios',PHP:'Filipenses',COL:'Colossenses','1TH':'1 Tessalonicenses','2TH':'2 Tessalonicenses','1TI':'1 Timóteo','2TI':'2 Timóteo',TIT:'Tito',PHM:'Filemom',HEB:'Hebreus',JAS:'Tiago','1PE':'1 Pedro','2PE':'2 Pedro','1JN':'1 João','2JN':'2 João','3JN':'3 João',JUD:'Judas',REV:'Apocalipse'};\nfunction ref(a){var m=/bible\\/129\\/([0-9A-Z]+)\\.(\\d+)(?:\\.([\\d\\-]+))?\\.NVI/.exec(a.getAttribute('href')||'');if(!m)return '';return (N[m[1]]||m[1])+' '+m[2]+(m[3]?':'+m[3]:'')}\nvar pop=null,tm=null,hide=null,held=false,sx=0,sy=0;\nfunction fecha(){if(pop){pop.classList.remove('on');var p=pop;setTimeout(function(){if(p.parentNode)p.parentNode.removeChild(p)},220);pop=null}clearTimeout(hide)}\nfunction mostra(k){var li=k.closest('li');if(!li)return;var seen={},out=[],as=li.querySelectorAll('a.in');\n for(var i=0;i<as.length;i++){var r=ref(as[i]);if(r&&!seen[r]){seen[r]=1;out.push(r)}}\n if(!out.length)return;fecha();pop=document.createElement('div');pop.className='refpop';pop.textContent=out.join('\\n');pop.style.whiteSpace='pre-line';document.body.appendChild(pop);\n var rc=k.getBoundingClientRect(),w=pop.offsetWidth,left=Math.max(12,Math.min(rc.left+window.pageXOffset,window.pageXOffset+document.documentElement.clientWidth-w-12));\n pop.style.left=left+'px';pop.style.top=(rc.bottom+window.pageYOffset+8)+'px';\n requestAnimationFrame(function(){if(pop)pop.classList.add('on')});\n hide=setTimeout(fecha,3500);held=true}\ndocument.addEventListener('pointerdown',function(e){var k=e.target.closest&&e.target.closest('.seq .k');if(!k)return;sx=e.clientX;sy=e.clientY;held=false;clearTimeout(tm);tm=setTimeout(function(){mostra(k)},420)});\n['pointerup','pointercancel'].forEach(function(t){document.addEventListener(t,function(){clearTimeout(tm)})});\ndocument.addEventListener('pointermove',function(e){if(Math.abs(e.clientX-sx)>12||Math.abs(e.clientY-sy)>12)clearTimeout(tm)});\ndocument.addEventListener('contextmenu',function(e){if(e.target.closest&&e.target.closest('.seq .k'))e.preventDefault()});\ndocument.addEventListener('click',function(e){if(held){held=false;e.stopPropagation();e.preventDefault()}},true);\n})();\n</script>\n</body>\n</html>\n"}