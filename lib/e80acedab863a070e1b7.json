.clientY-sy)>12)clearTimeout(tm)});\ndocument.addEventListener('contextmenu',function(e){if(e.target.closest&&e.target.closest('.seq .k'))e.preventDefault()});\ndocument.addEventListener('click',function(e){if(held){held=false;e.stopPropagation();e.preventDefault()}},true);\n})();\n(function(){\nvar V=document.querySelectorAll('.cit.bv');\nfor(var i=0;i<V.length;i++){(function(v){\n v.setAttribute('role','button');v.setAttribute('tabindex','0');\n function t(e){if(e.target.closest&&e.target.closest('a'))return;v.classList.toggle('on')}\n v.addEventListener('click',t);\n v.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();t(e)}});\n})(V[i])}\n})();\n(function(){\nvar B=document.querySelectorAll('.cit.bv > blockquote');\nfor(var i=0;i<B.length;i++){var b=B[i];if(b.children.length||b.textContent.length<400)continue;var s=b.textContent.replace(/([.!?\\u2026]\\)?)\\s+(?=[A-Z\\u00C0-\\u00DD\\u201C\"])/g,'$1\\u0001').split('\\u0001');if(s.length<2)continue;b.textContent='';for(var k=0;k<s.length;k++){var e=document.createElement('p');e.className='gen';e.textContent=s[k];b.appendChild(e)}}\nvar F=document.querySelectorAll('.cit');\nfor(var i=0;i<F.length;i++){var P=F[i].querySelectorAll('blockquote > p.gen');if(P.length<2)continue;var n=0;for(var j=0;j<P.length;j++)n+=P[j].textContent.length;if(P.length>=3||n>(F[i].classList.contains('bv')?400:700))F[i].classList.add('tl');else{for(var k=1;k<P.length;k++){P[0].appendChild(document.createTextNode(' '));while(P[k].firstChild)P[0].appendChild(P[k].firstChild);P[k].parentNode.removeChild(P[k])}}}\n})();\n</script>\n</body>\n</html>\n"}