{"p":"PROFETICO/Os Dois Misterios/MATERIAIS/Capítulo 01 - Humildade/Capítulo 01.html","h":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#fbfaf7\">\n<title>Capítulo 01 - Um exemplo de humildade</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700;800&family=DM+Sans:wght@400..700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#fbfaf7; --card:#f3f0e8; --in:#fbfaf7; --tx:#211e19; --tx2:#7a7368; --bd:#e2ddd1;\n  --main:#7b2d26; --chip:#f3f0e8; --chipTx:#211e19; --track:#e2ddd1;\n  --fs:17px;\n}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--bg);color:var(--tx);font-family:'DM Sans',system-ui,sans-serif;font-size:var(--fs);line-height:1.7;-webkit-text-size-adjust:100%}\n.wrap{max-width:680px;margin:0 auto;padding:12px 16px calc(40px + env(safe-area-inset-bottom))}\n\n.top{position:sticky;top:0;z-index:20;margin:0 -16px;padding:calc(10px + env(safe-area-inset-top)) 16px 10px;background:rgba(251,250,247,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}\n.top-in{display:flex;align-items:center;gap:10px;min-height:44px}\n.top-name{flex:1;min-width:0;font-family:'Barlow',sans-serif;font-weight:600;font-size:15px;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.top-name small{display:block;font-family:'DM Sans',sans-serif;font-weight:500;font-size:12px;color:var(--tx2)}\n.seg{display:flex;background:var(--track);border-radius:999px;padding:4px;gap:2px}\n.seg button{height:36px;min-width:44px;padding:0 12px;border:0;border-radius:999px;background:transparent;color:var(--tx2);font:600 14px 'DM Sans',sans-serif;curso